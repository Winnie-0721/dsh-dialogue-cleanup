# 依赖（本项目零运行时依赖，这个目录只在本地跑测试/装工具时出现）
node_modules/

# 编辑器与系统噪声
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini

# 日志与临时文件
*.log
*.tmp

# 打包产物：只在 CI 工作区生成（pnpm pack 的落点），本地与仓库里都不留。
# 回退 / 旧版安装一律从 GitHub Release 附件下载，所以这里必须忽略。
dist/

# 一次性脚本与草稿（发布辅助、调试探针、提交信息草稿，一律不入库）
_*.mjs
_*.txt
_push-api.mjs

# 测试/变异运行的中间输出。CI 里用 upload-artifact 留存，不进仓库。
# （踩过：一次 `node --test > tapC.txt` 的日志被误提交，1438 行且是 CRLF，
#   既污染仓库又会触发行尾守卫。这里把常见形态一次性忽略掉。）
test-output.tap
*.tap
tap*.txt
mutation.log

# 截图脚本的中间产物（PNG 才入库）
docs/assets/*.html
